{
  "$comment": "Local OpenAI wire rehearsal only. Source authentication, exact request regeneration, durable intent and native completion are application checks. No live authorization or model-delivery provenance follows from schema validity.",
  "$defs": {
    "Exchange": {
      "additionalProperties": false,
      "properties": {
        "dispatched_body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Bytes Sha256",
          "type": "string"
        },
        "dispatched_body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Canonical Sha256",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "response",
            "interrupted",
            "transport_error",
            "cancelled",
            "capture_error"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "endpoint_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Canonical Sha256",
          "type": "string"
        },
        "local_error": {
          "anyOf": [
            {
              "enum": [
                "transport_error",
                "cancelled",
                "capture_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Error"
        },
        "observed_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Http Status"
        },
        "observed_raw_http_bytes_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Raw Http Bytes Sha256"
        },
        "raw_http_bytes_retained": {
          "const": false,
          "title": "Raw Http Bytes Retained",
          "type": "boolean"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappedResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_response_canonical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retained Response Canonical Sha256"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "endpoint_canonical_sha256",
        "dispatched_body_bytes_sha256",
        "dispatched_body_canonical_sha256",
        "disposition",
        "observed_http_status",
        "response",
        "retained_response_canonical_sha256",
        "observed_raw_http_bytes_sha256",
        "raw_http_bytes_retained",
        "local_error"
      ],
      "title": "Exchange",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Attempt Id",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/WireEndpoint"
        },
        "kind": {
          "const": "intent",
          "title": "Kind",
          "type": "string"
        },
        "request_payload_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Payload Canonical Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "attempt_id",
        "request_payload_canonical_sha256",
        "endpoint"
      ],
      "title": "Intent",
      "type": "object"
    },
    "MappedResponse": {
      "additionalProperties": false,
      "properties": {
        "actual_billed_cost": {
          "title": "Actual Billed Cost",
          "type": "null"
        },
        "authentication": {
          "const": "mapping_only_not_delivery_authentication",
          "title": "Authentication",
          "type": "string"
        },
        "contract": {
          "const": "assessment-openai-mapped-response-1",
          "title": "Contract",
          "type": "string"
        },
        "counted_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Input Tokens"
        },
        "error_codes": {
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "incomplete_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Incomplete Reason"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "raw_final": {
          "anyOf": [
            {
              "maxLength": 64000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final"
        },
        "raw_final_utf8_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final Utf8 Sha256"
        },
        "response_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "returned_model": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Returned Model"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "state": {
          "enum": [
            "counted",
            "complete",
            "length",
            "refusal",
            "error",
            "invalid"
          ],
          "title": "State",
          "type": "string"
        },
        "terminal_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Status"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "writer_dispatch_authorized": {
          "const": false,
          "title": "Writer Dispatch Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "stage",
        "http_status",
        "state",
        "response_id",
        "returned_model",
        "terminal_status",
        "incomplete_reason",
        "raw_final",
        "raw_final_utf8_sha256",
        "usage",
        "counted_input_tokens",
        "issues",
        "error_codes",
        "actual_billed_cost",
        "authentication",
        "writer_dispatch_authorized"
      ],
      "title": "MappedResponse",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "active_seconds": {
          "minimum": 0,
          "title": "Active Seconds",
          "type": "number"
        },
        "exchange": {
          "$ref": "#/$defs/Exchange"
        },
        "intent_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Bytes Sha256",
          "type": "string"
        },
        "kind": {
          "const": "outcome",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "intent_bytes_sha256",
        "exchange",
        "active_seconds"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "enum": [
            "complete",
            "halted",
            "cancelled_before_dispatch"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "Stop",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens"
      ],
      "title": "Usage",
      "type": "object"
    },
    "WireEndpoint": {
      "additionalProperties": false,
      "properties": {
        "body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Bytes Sha256",
          "type": "string"
        },
        "body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Canonical Sha256",
          "type": "string"
        },
        "body_utf8": {
          "title": "Body Utf8",
          "type": "string"
        },
        "destination": {
          "const": "https://api.openai.com",
          "title": "Destination",
          "type": "string"
        },
        "method": {
          "const": "POST",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "enum": [
            "/v1/responses",
            "/v1/responses/input_tokens"
          ],
          "title": "Path",
          "type": "string"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "method",
        "destination",
        "path",
        "body_utf8",
        "body_bytes_sha256",
        "body_canonical_sha256"
      ],
      "title": "WireEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "assessment-openai-fixture-event-1",
      "title": "Contract",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "intent": "#/$defs/Intent",
          "outcome": "#/$defs/Outcome",
          "stop": "#/$defs/Stop"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Intent"
        },
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "$ref": "#/$defs/Stop"
        }
      ],
      "title": "Payload"
    },
    "previous_bytes_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Bytes Sha256",
      "type": "string"
    },
    "recorded_at_utc": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Recorded At Utc",
      "type": "string"
    },
    "sequence": {
      "maximum": 49,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "contract",
    "sequence",
    "previous_bytes_sha256",
    "recorded_at_utc",
    "payload"
  ],
  "title": "JournalEvent",
  "type": "object"
}
