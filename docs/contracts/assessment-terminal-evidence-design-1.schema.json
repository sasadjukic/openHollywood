{
  "$comment": "Local design fixture shape only. Hash consistency is not authentication. No application parser accepts this contract; terminal receipts must be derived.",
  "$defs": {
    "ErrorLink": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Category",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "layer": {
          "enum": [
            "client",
            "daemon",
            "gateway",
            "provider"
          ],
          "title": "Layer",
          "type": "string"
        },
        "safe_message": {
          "maxLength": 1200,
          "title": "Safe Message",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "category",
        "code",
        "safe_message"
      ],
      "title": "ErrorLink",
      "type": "object"
    },
    "Exchange": {
      "additionalProperties": false,
      "properties": {
        "dispatched_body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Bytes Sha256",
          "type": "string"
        },
        "dispatched_body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Canonical Sha256",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "response",
            "interrupted",
            "transport_error",
            "cancelled"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "endpoint_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Canonical Sha256",
          "type": "string"
        },
        "local_error_chain": {
          "items": {
            "$ref": "#/$defs/ErrorLink"
          },
          "maxItems": 8,
          "title": "Local Error Chain",
          "type": "array"
        },
        "observed_raw_http_bytes_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Raw Http Bytes Sha256"
        },
        "raw_http_bytes_retained": {
          "const": false,
          "title": "Raw Http Bytes Retained",
          "type": "boolean"
        },
        "retained_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetainedResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_response_canonical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retained Response Canonical Sha256"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "endpoint_canonical_sha256",
        "dispatched_body_bytes_sha256",
        "dispatched_body_canonical_sha256",
        "disposition",
        "retained_response",
        "retained_response_canonical_sha256",
        "observed_raw_http_bytes_sha256",
        "raw_http_bytes_retained",
        "local_error_chain"
      ],
      "title": "Exchange",
      "type": "object"
    },
    "RetainedResponse": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "safe-response-design-1",
          "title": "Contract",
          "type": "string"
        },
        "counted_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Input Tokens"
        },
        "error_chain": {
          "items": {
            "$ref": "#/$defs/ErrorLink"
          },
          "maxItems": 8,
          "title": "Error Chain",
          "type": "array"
        },
        "finish_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finish Reason"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "raw_final": {
          "anyOf": [
            {
              "maxLength": 64000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final"
        },
        "response_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "returned_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Returned Model"
        },
        "state": {
          "enum": [
            "complete",
            "length",
            "refusal",
            "error",
            "unrecognized"
          ],
          "title": "State",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "contract",
        "http_status",
        "state",
        "response_id",
        "returned_model",
        "finish_reason",
        "raw_final",
        "usage",
        "counted_input_tokens",
        "error_chain"
      ],
      "title": "RetainedResponse",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_seconds": {
      "minimum": 0,
      "title": "Active Seconds",
      "type": "number"
    },
    "attempt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Attempt Id",
      "type": "string"
    },
    "contract": {
      "const": "assessment-terminal-evidence-design-1",
      "title": "Contract",
      "type": "string"
    },
    "exchanges": {
      "items": {
        "$ref": "#/$defs/Exchange"
      },
      "maxItems": 2,
      "title": "Exchanges",
      "type": "array"
    },
    "origin": {
      "const": "authored_fixture",
      "title": "Origin",
      "type": "string"
    },
    "request_payload_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Payload Canonical Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "origin",
    "request_payload_canonical_sha256",
    "attempt_id",
    "exchanges",
    "active_seconds"
  ],
  "title": "TerminalEvidence",
  "type": "object"
}
