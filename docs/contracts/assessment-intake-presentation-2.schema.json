{
  "$defs": {
    "JsonValue": {},
    "SavedMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "SavedMessage",
      "type": "object"
    },
    "SourcePin": {
      "additionalProperties": false,
      "properties": {
        "briefs_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Briefs Canonical Sha256",
          "type": "string"
        },
        "declarations_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Declarations Canonical Sha256",
          "type": "string"
        },
        "intake_manifest_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intake Manifest Bytes Sha256",
          "type": "string"
        },
        "intake_result_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intake Result Bytes Sha256",
          "type": "string"
        },
        "review_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Review Id",
          "type": "string"
        },
        "source_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Canonical Sha256",
          "type": "string"
        },
        "source_origin": {
          "const": "diagnostic_probe",
          "title": "Source Origin",
          "type": "string"
        },
        "work_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Work Canonical Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_origin",
        "review_id",
        "intake_manifest_bytes_sha256",
        "intake_result_bytes_sha256",
        "source_canonical_sha256",
        "work_canonical_sha256",
        "declarations_canonical_sha256",
        "briefs_canonical_sha256"
      ],
      "title": "SourcePin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_unit_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Active Unit Ids",
      "type": "array"
    },
    "batch_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "contract": {
      "const": "assessment-intake-presentation-2",
      "title": "Contract",
      "type": "string"
    },
    "live_authorized": {
      "const": false,
      "title": "Live Authorized",
      "type": "boolean"
    },
    "local_provenance_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Local Provenance Canonical Sha256",
      "type": "string"
    },
    "messages": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/SavedMessage"
        },
        {
          "$ref": "#/$defs/SavedMessage"
        }
      ],
      "title": "Messages",
      "type": "array"
    },
    "messages_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Messages Canonical Sha256",
      "type": "string"
    },
    "original_packet_bytes_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Packet Bytes Sha256",
      "type": "string"
    },
    "production_prompt_changed": {
      "const": false,
      "title": "Production Prompt Changed",
      "type": "boolean"
    },
    "response_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Response Schema",
      "type": "object"
    },
    "schema_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Schema Canonical Sha256",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourcePin"
    }
  },
  "required": [
    "contract",
    "source",
    "batch_id",
    "active_unit_ids",
    "messages",
    "messages_canonical_sha256",
    "response_schema",
    "schema_canonical_sha256",
    "original_packet_bytes_sha256",
    "local_provenance_canonical_sha256",
    "production_prompt_changed",
    "live_authorized"
  ],
  "title": "CompactPresentation",
  "type": "object"
}
