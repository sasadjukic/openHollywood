{
  "$comment": "Runtime fixture-only contract. Source, actual-byte capture and completion are verified by the application; shape or caller hashes do not authenticate a model delivery.",
  "$defs": {
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Bytes Sha256",
          "type": "string"
        },
        "body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Canonical Sha256",
          "type": "string"
        },
        "body_utf8": {
          "maxLength": 16777216,
          "minLength": 1,
          "title": "Body Utf8",
          "type": "string"
        },
        "destination": {
          "const": "https://assessment-fixture.invalid",
          "title": "Destination",
          "type": "string"
        },
        "method": {
          "const": "POST",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "enum": [
            "/fixture/count",
            "/fixture/generate"
          ],
          "title": "Path",
          "type": "string"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "method",
        "destination",
        "path",
        "body_utf8",
        "body_bytes_sha256",
        "body_canonical_sha256"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "ErrorLink": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Category",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "layer": {
          "enum": [
            "client",
            "daemon",
            "gateway",
            "provider"
          ],
          "title": "Layer",
          "type": "string"
        },
        "safe_message": {
          "maxLength": 1200,
          "title": "Safe Message",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "category",
        "code",
        "safe_message"
      ],
      "title": "ErrorLink",
      "type": "object"
    },
    "Exchange": {
      "additionalProperties": false,
      "properties": {
        "dispatched_body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Bytes Sha256",
          "type": "string"
        },
        "dispatched_body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Canonical Sha256",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "response",
            "interrupted",
            "transport_error",
            "cancelled",
            "capture_error"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "endpoint_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Canonical Sha256",
          "type": "string"
        },
        "local_error_chain": {
          "items": {
            "$ref": "#/$defs/ErrorLink"
          },
          "maxItems": 8,
          "title": "Local Error Chain",
          "type": "array"
        },
        "observed_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Http Status"
        },
        "observed_raw_http_bytes_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Raw Http Bytes Sha256"
        },
        "raw_http_bytes_retained": {
          "const": false,
          "title": "Raw Http Bytes Retained",
          "type": "boolean"
        },
        "retained_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetainedResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_response_canonical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retained Response Canonical Sha256"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "endpoint_canonical_sha256",
        "dispatched_body_bytes_sha256",
        "dispatched_body_canonical_sha256",
        "disposition",
        "observed_http_status",
        "retained_response",
        "retained_response_canonical_sha256",
        "observed_raw_http_bytes_sha256",
        "raw_http_bytes_retained",
        "local_error_chain"
      ],
      "title": "Exchange",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Attempt Id",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "kind": {
          "const": "intent",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "attempt_id",
        "endpoint"
      ],
      "title": "Intent",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "active_seconds": {
          "minimum": 0,
          "title": "Active Seconds",
          "type": "number"
        },
        "exchange": {
          "$ref": "#/$defs/Exchange"
        },
        "intent_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Bytes Sha256",
          "type": "string"
        },
        "kind": {
          "const": "outcome",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "intent_bytes_sha256",
        "exchange",
        "active_seconds"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "RetainedResponse": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "assessment-fixture-safe-response-1",
          "title": "Contract",
          "type": "string"
        },
        "counted_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Input Tokens"
        },
        "error_chain": {
          "items": {
            "$ref": "#/$defs/ErrorLink"
          },
          "maxItems": 8,
          "title": "Error Chain",
          "type": "array"
        },
        "finish_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finish Reason"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "raw_final": {
          "anyOf": [
            {
              "maxLength": 64000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final"
        },
        "response_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "returned_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Returned Model"
        },
        "state": {
          "enum": [
            "complete",
            "length",
            "refusal",
            "error",
            "unrecognized"
          ],
          "title": "State",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "contract",
        "http_status",
        "state",
        "response_id",
        "returned_model",
        "finish_reason",
        "raw_final",
        "usage",
        "counted_input_tokens",
        "error_chain"
      ],
      "title": "RetainedResponse",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "enum": [
            "complete",
            "halted",
            "cancelled_before_dispatch"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "Stop",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "assessment-fixture-journal-event-1",
      "title": "Contract",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "intent": "#/$defs/Intent",
          "outcome": "#/$defs/Outcome",
          "stop": "#/$defs/Stop"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Intent"
        },
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "$ref": "#/$defs/Stop"
        }
      ],
      "title": "Payload"
    },
    "previous_bytes_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Bytes Sha256",
      "type": "string"
    },
    "recorded_at_utc": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Recorded At Utc",
      "type": "string"
    },
    "sequence": {
      "maximum": 49,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "contract",
    "sequence",
    "previous_bytes_sha256",
    "recorded_at_utc",
    "payload"
  ],
  "title": "JournalEvent",
  "type": "object"
}
