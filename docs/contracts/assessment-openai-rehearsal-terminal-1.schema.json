{
  "$comment": "Local OpenAI wire rehearsal only. Source authentication, exact request regeneration, durable intent and native completion are application checks. No live authorization or model-delivery provenance follows from schema validity.",
  "$defs": {
    "AssessmentReceipt": {
      "additionalProperties": false,
      "description": "Delivery facts only. A structurally valid result is still semantically unassessed.",
      "properties": {
        "active_seconds": {
          "minimum": 0,
          "title": "Active Seconds",
          "type": "number"
        },
        "assessed_unit_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Assessed Unit Ids",
          "type": "array"
        },
        "attempt_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "batch_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "binding": {
          "default": "unresolved",
          "enum": [
            "unresolved",
            "complete"
          ],
          "title": "Binding",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "status": {
          "enum": [
            "valid",
            "invalid",
            "length",
            "refusal",
            "transport_error",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "work_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Work Sha256",
          "type": "string"
        }
      },
      "required": [
        "work_sha256",
        "batch_id",
        "request_sha256",
        "attempt_id",
        "status",
        "active_seconds"
      ],
      "title": "AssessmentReceipt",
      "type": "object"
    },
    "Exchange": {
      "additionalProperties": false,
      "properties": {
        "dispatched_body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Bytes Sha256",
          "type": "string"
        },
        "dispatched_body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Canonical Sha256",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "response",
            "interrupted",
            "transport_error",
            "cancelled",
            "capture_error"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "endpoint_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Canonical Sha256",
          "type": "string"
        },
        "local_error": {
          "anyOf": [
            {
              "enum": [
                "transport_error",
                "cancelled",
                "capture_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Error"
        },
        "observed_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Http Status"
        },
        "observed_raw_http_bytes_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Raw Http Bytes Sha256"
        },
        "raw_http_bytes_retained": {
          "const": false,
          "title": "Raw Http Bytes Retained",
          "type": "boolean"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappedResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_response_canonical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retained Response Canonical Sha256"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "endpoint_canonical_sha256",
        "dispatched_body_bytes_sha256",
        "dispatched_body_canonical_sha256",
        "disposition",
        "observed_http_status",
        "response",
        "retained_response_canonical_sha256",
        "observed_raw_http_bytes_sha256",
        "raw_http_bytes_retained",
        "local_error"
      ],
      "title": "Exchange",
      "type": "object"
    },
    "JsonValue": {},
    "MappedResponse": {
      "additionalProperties": false,
      "properties": {
        "actual_billed_cost": {
          "title": "Actual Billed Cost",
          "type": "null"
        },
        "authentication": {
          "const": "mapping_only_not_delivery_authentication",
          "title": "Authentication",
          "type": "string"
        },
        "contract": {
          "const": "assessment-openai-mapped-response-1",
          "title": "Contract",
          "type": "string"
        },
        "counted_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Input Tokens"
        },
        "error_codes": {
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "incomplete_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Incomplete Reason"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "raw_final": {
          "anyOf": [
            {
              "maxLength": 64000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final"
        },
        "raw_final_utf8_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final Utf8 Sha256"
        },
        "response_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "returned_model": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Returned Model"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "state": {
          "enum": [
            "counted",
            "complete",
            "length",
            "refusal",
            "error",
            "invalid"
          ],
          "title": "State",
          "type": "string"
        },
        "terminal_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Status"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "writer_dispatch_authorized": {
          "const": false,
          "title": "Writer Dispatch Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "stage",
        "http_status",
        "state",
        "response_id",
        "returned_model",
        "terminal_status",
        "incomplete_reason",
        "raw_final",
        "raw_final_utf8_sha256",
        "usage",
        "counted_input_tokens",
        "issues",
        "error_codes",
        "actual_billed_cost",
        "authentication",
        "writer_dispatch_authorized"
      ],
      "title": "MappedResponse",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounting_hold": {
      "title": "Accounting Hold",
      "type": "boolean"
    },
    "active_seconds": {
      "minimum": 0,
      "title": "Active Seconds",
      "type": "number"
    },
    "attempt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Attempt Id",
      "type": "string"
    },
    "bound_result": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Bound Result"
    },
    "contract": {
      "const": "assessment-openai-rehearsal-terminal-1",
      "title": "Contract",
      "type": "string"
    },
    "exchanges": {
      "items": {
        "$ref": "#/$defs/Exchange"
      },
      "title": "Exchanges",
      "type": "array"
    },
    "model_evidence": {
      "const": false,
      "title": "Model Evidence",
      "type": "boolean"
    },
    "native_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "const": "injected_fixture",
      "title": "Origin",
      "type": "string"
    },
    "request_payload_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Payload Canonical Sha256",
      "type": "string"
    },
    "state": {
      "enum": [
        "bound_unassessed",
        "failed",
        "generation_not_started"
      ],
      "title": "State",
      "type": "string"
    },
    "unknown_elapsed_endpoints": {
      "maximum": 1,
      "minimum": 0,
      "title": "Unknown Elapsed Endpoints",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "writer_dispatch_authorized": {
      "const": false,
      "title": "Writer Dispatch Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "contract",
    "origin",
    "request_payload_canonical_sha256",
    "attempt_id",
    "exchanges",
    "active_seconds",
    "unknown_elapsed_endpoints",
    "native_receipt",
    "bound_result",
    "usage",
    "accounting_hold",
    "state",
    "model_evidence",
    "writer_dispatch_authorized"
  ],
  "title": "Terminal",
  "type": "object"
}
