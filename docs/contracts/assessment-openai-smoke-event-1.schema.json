{
  "$defs": {
    "Exchange": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "endpoint_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Canonical Sha256",
          "type": "string"
        },
        "dispatched_body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Bytes Sha256",
          "type": "string"
        },
        "dispatched_body_canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatched Body Canonical Sha256",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "response",
            "interrupted",
            "transport_error",
            "cancelled",
            "capture_error"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "observed_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Http Status"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappedResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_response_canonical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retained Response Canonical Sha256"
        },
        "observed_raw_http_bytes_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Raw Http Bytes Sha256"
        },
        "raw_http_bytes_retained": {
          "const": false,
          "title": "Raw Http Bytes Retained",
          "type": "boolean"
        },
        "local_error": {
          "anyOf": [
            {
              "enum": [
                "transport_error",
                "cancelled",
                "capture_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Error"
        }
      },
      "required": [
        "stage",
        "endpoint_canonical_sha256",
        "dispatched_body_bytes_sha256",
        "dispatched_body_canonical_sha256",
        "disposition",
        "observed_http_status",
        "response",
        "retained_response_canonical_sha256",
        "observed_raw_http_bytes_sha256",
        "raw_http_bytes_retained",
        "local_error"
      ],
      "title": "Exchange",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "intent",
          "title": "Kind",
          "type": "string"
        },
        "work": {
          "title": "Work",
          "type": "string"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "request_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Payload Sha256",
          "type": "string"
        },
        "endpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Sha256",
          "type": "string"
        },
        "body_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Bytes Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "work",
        "stage",
        "request_payload_sha256",
        "endpoint_sha256",
        "body_bytes_sha256"
      ],
      "title": "Intent",
      "type": "object"
    },
    "MappedResponse": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "assessment-openai-mapped-response-1",
          "title": "Contract",
          "type": "string"
        },
        "stage": {
          "enum": [
            "input_count",
            "generation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "state": {
          "enum": [
            "counted",
            "complete",
            "length",
            "refusal",
            "error",
            "invalid"
          ],
          "title": "State",
          "type": "string"
        },
        "response_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "returned_model": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Returned Model"
        },
        "terminal_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Status"
        },
        "incomplete_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Incomplete Reason"
        },
        "raw_final": {
          "anyOf": [
            {
              "maxLength": 64000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final"
        },
        "raw_final_utf8_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Final Utf8 Sha256"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "counted_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Input Tokens"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "error_codes": {
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "actual_billed_cost": {
          "title": "Actual Billed Cost",
          "type": "null"
        },
        "authentication": {
          "const": "mapping_only_not_delivery_authentication",
          "title": "Authentication",
          "type": "string"
        },
        "writer_dispatch_authorized": {
          "const": false,
          "title": "Writer Dispatch Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "stage",
        "http_status",
        "state",
        "response_id",
        "returned_model",
        "terminal_status",
        "incomplete_reason",
        "raw_final",
        "raw_final_utf8_sha256",
        "usage",
        "counted_input_tokens",
        "issues",
        "error_codes",
        "actual_billed_cost",
        "authentication",
        "writer_dispatch_authorized"
      ],
      "title": "MappedResponse",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "outcome",
          "title": "Kind",
          "type": "string"
        },
        "intent_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Bytes Sha256",
          "type": "string"
        },
        "exchange": {
          "$ref": "#/$defs/Exchange"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "intent_bytes_sha256",
        "exchange",
        "request_id",
        "elapsed_seconds"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "enum": [
            "complete",
            "halted",
            "deadline",
            "cancelled"
          ],
          "title": "Reason",
          "type": "string"
        },
        "elapsed_wall_seconds": {
          "minimum": 0,
          "title": "Elapsed Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "reason",
        "elapsed_wall_seconds"
      ],
      "title": "Stop",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "assessment-openai-smoke-event-1",
      "title": "Contract",
      "type": "string"
    },
    "sequence": {
      "maximum": 17,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "previous_bytes_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Bytes Sha256",
      "type": "string"
    },
    "recorded_at_utc": {
      "title": "Recorded At Utc",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "intent": "#/$defs/Intent",
          "outcome": "#/$defs/Outcome",
          "stop": "#/$defs/Stop"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Intent"
        },
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "$ref": "#/$defs/Stop"
        }
      ],
      "title": "Payload"
    }
  },
  "required": [
    "contract",
    "sequence",
    "previous_bytes_sha256",
    "recorded_at_utc",
    "payload"
  ],
  "title": "Event",
  "type": "object",
  "$comment": "Shape only. Source authentication, exact request regeneration, approval, fixed one-shot journal and native binding are runtime checks. Not a provider attestation."
}
